# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Local agent sessions and editor-generated Xcode backups
/.claude/sessions/
/ios/Runner.xcodeproj/*.backup
/ios/Runner.xcodeproj/xcshareddata/xcschemes/*.backup

# Release signing and local configuration
/android/key.properties
*.jks
*.keystore
.env
.env.*
!.env.example
