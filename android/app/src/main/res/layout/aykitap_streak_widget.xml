<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aykitap_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/aykitap_widget_flame_glow"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="#88FF5C7D"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="7"
            android:text="🔥"
            android:textSize="29sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/streak_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:includeFontPadding="false"
                android:text="4 day streak"
                android:textColor="#211D2B"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/streak_best"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/gilroy_regular"
                android:includeFontPadding="false"
                android:text="Best: 12 days"
                android:textColor="#746D7D"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Two stacked lines, each with its own size/weight, rather than one
             TextView with a literal "\n" — a single TextView forces both
             lines to share one textSize/textStyle, which is why the count
             and the "pages today" caption used to look like the same weight
             instead of a real number-then-label hierarchy. The caption also
             now genuinely renders gilroy_regular's un-bolded weight, instead
             of every line in the pill being synthetically bolded. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/aykitap_widget_stat_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/streak_today_pages_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:includeFontPadding="false"
                android:text="18"
                android:textColor="#E8712C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/gilroy_regular"
                android:includeFontPadding="false"
                android:text="pages today"
                android:textColor="#8B8491"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/aykitap_widget_week_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_1_circle" style="@style/AykitapStreakDayCircle" /><TextView android:id="@+id/streak_day_1_label" style="@style/AykitapStreakDayLabel" android:text="M" /></LinearLayout>
        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_2_circle" style="@style/AykitapStreakDayCircle" /><TextView android:id="@+id/streak_day_2_label" style="@style/AykitapStreakDayLabel" android:text="T" /></LinearLayout>
        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_3_circle" style="@style/AykitapStreakDayCircle" /><TextView android:id="@+id/streak_day_3_label" style="@style/AykitapStreakDayLabel" android:text="W" /></LinearLayout>
        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_4_circle" style="@style/AykitapStreakDayCircle" /><TextView android:id="@+id/streak_day_4_label" style="@style/AykitapStreakDayLabel" android:text="T" /></LinearLayout>
        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_5_circle" style="@style/AykitapStreakDayCircle" android:text="•" /><TextView android:id="@+id/streak_day_5_label" style="@style/AykitapStreakDayLabel" android:text="F" /></LinearLayout>
        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_6_circle" style="@style/AykitapStreakDayCircle" /><TextView android:id="@+id/streak_day_6_label" style="@style/AykitapStreakDayLabel" android:text="S" /></LinearLayout>
        <LinearLayout style="@style/AykitapStreakDayColumn"><TextView android:id="@+id/streak_day_7_circle" style="@style/AykitapStreakDayCircle" /><TextView android:id="@+id/streak_day_7_label" style="@style/AykitapStreakDayLabel" android:text="S" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
