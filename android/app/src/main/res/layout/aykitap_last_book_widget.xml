<!-- One UI gives this 4x2 widget 401x208dp. Three equal flexible spaces sit
     above, between, and below the metadata/action groups. The result remains a
     cohesive centred composition instead of pinning labels to opposite edges. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/aykitap_widget_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingTop="8dp"
        android:paddingEnd="11dp"
        android:paddingBottom="8dp">

        <!-- Fixed 2:3 box rather than match_parent height: the cover bitmap is
             center-cropped to that ratio and has its corners rounded in
             AykitapReadingWidgetProvider (RemoteViews can't clip an ImageView
             to its background's radius), so the box has to match the bitmap's
             ratio or the rounded corners would be cropped straight again. -->
        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="117dp"
            android:background="@drawable/aykitap_widget_cover">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Book cover"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_cover_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="11dp"
                android:adjustViewBounds="true"
                android:contentDescription="AÝ KITAP"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <ImageView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="CONTINUE READING"
                android:scaleType="fitStart" />

            <ImageView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:adjustViewBounds="true"
                android:contentDescription="The Little Prince"
                android:scaleType="fitStart" />

            <!-- GONE, not blank, when the catalogue entry has no author list —
                 an empty line would push the rest of the column down for
                 nothing. Same reasoning as the progress row below. -->
            <ImageView
                android:id="@+id/widget_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:adjustViewBounds="true"
                android:contentDescription="Antoine de Saint-Exupéry"
                android:scaleType="fitStart" />

            <ImageView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:adjustViewBounds="true"
                android:contentDescription="Page 82 of 240 · 158 left"
                android:scaleType="fitStart" />

            <!-- The middle third of the flexible height. Matching spacers sit
                 above the metadata and below the action. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/widget_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Hidden entirely (not just 0%) when there's no book yet — a stub
                     progress bar sitting at 0% next to "choose your next book" read
                     as clutter rather than progress. GONE closes the gap on its own,
                     no conditional margins needed on the CTA below. -->
                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="34"
                    android:progressDrawable="@drawable/aykitap_widget_progress" />

                <ImageView
                    android:id="@+id/widget_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="34%"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/aykitap_widget_cta_chip"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:adjustViewBounds="true"
                android:contentDescription="Tap to continue"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
