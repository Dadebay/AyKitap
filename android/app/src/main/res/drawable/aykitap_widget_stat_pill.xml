<!-- A soft orange badge rather than the old bordered white block. On the
     card's pink gradient an opaque white panel with its own outline read as
     a second card pasted into the streak row; a borderless tint belonging to
     the same family as the orange count reads as part of that row. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#30E8712C" />
    <corners android:radius="14dp" />
</shape>
