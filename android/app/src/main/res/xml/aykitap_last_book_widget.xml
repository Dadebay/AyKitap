<!-- Sized to the card's own ~139dp of content now that the layout wraps
     instead of stretching: anything taller only ever showed as empty card
     under the CTA. minResizeHeight matches so the card can't be dragged
     below the height its content needs. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:minResizeHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:initialLayout="@layout/aykitap_last_book_widget"
    android:previewLayout="@layout/aykitap_last_book_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
