<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- largeHeap: a reader app is unusually memory-hungry for its size —
         PDFium maps whole books (17MB+ is normal here), Flutter's image cache
         holds tens of MB of covers, and the epub reader carries a WebView.
         The standard per-app heap is what a 17MB PDF was dying against: scudo
         reported it could not populate pages for *every* size class, i.e. the
         process could not get memory from the OS at all. -->
    <application
        android:label="Aýkitap"
        android:name="${applicationName}"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:usesCleartextTraffic="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets other apps (Telegram, Files, mail clients, ...) list
                 Aýkitap in their "Open with" chooser for book files, and
                 hands the tapped file to MainActivity via ACTION_VIEW. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:mimeType="application/pdf" />
                <data
                    android:scheme="content"
                    android:mimeType="application/epub+zip" />
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.comicbook+zip" />
                <data
                    android:scheme="content"
                    android:mimeType="application/x-cbz" />
                <data
                    android:scheme="file"
                    android:mimeType="application/pdf" />
                <data
                    android:scheme="file"
                    android:mimeType="application/epub+zip" />
                <data
                    android:scheme="file"
                    android:mimeType="application/vnd.comicbook+zip" />
                <data
                    android:scheme="file"
                    android:mimeType="application/x-cbz" />
            </intent-filter>
            <!-- aykitap://book/<id> deep link — lets the website (or any
                 other app) send a user straight to a book's detail screen.
                 Handled in Dart by DeepLinkService. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aykitap" />
            </intent-filter>
            <!-- RevenueCat's per-app custom URL scheme (dashboard: Apps >
                 Aykitap Play Store > Custom URL Scheme) — lets dashboard
                 features like Paywall Preview deep-link back into this exact
                 app. Not handled in Dart; the RevenueCat SDK/OS resolves it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rc-9ed5639f14" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".AykitapReadingWidgetProvider"
            android:exported="true"
            android:label="Aýkitap · Continue Reading">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aykitap_last_book_widget" />
        </receiver>
        <receiver
            android:name=".AykitapStreakWidgetProvider"
            android:exported="true"
            android:label="Aýkitap · Reading Streak">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aykitap_streak_widget" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Lets url_launcher find a browser on Android 11+ (package visibility). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
